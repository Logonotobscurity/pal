# PAL environment variables
#
# Rule (PAL_ARCHITECTURE.md §73 Rule 2): every variable used by the
# application must be documented here. Never commit real values.
# Copy to .env.local and fill in locally.

# --- Supabase (Task 3: auth + workspace tenancy) ---

# Project URL, e.g. https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Database URL (for migrations only, not runtime)
DATABASE_URL=

# Public anon key. Safe for the browser; subject to RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. BYPASSES RLS. Server-side only — never expose to the
# browser, never prefix with NEXT_PUBLIC_ (PAL_ARCHITECTURE.md §43).
SUPABASE_SERVICE_ROLE_KEY=

# --- Sahara Voice Provider (Task: Voice Ingestion Pipeline) ---

# Sahara API secret. Server-side only; never expose to the browser.
# Used for authenticating streaming speech-to-text connections.
SAHARA_API_SECRET=

# Sahara WebSocket endpoint for streaming audio transcription
SAHARA_WS_ENDPOINT=wss://api.sahara.ai/v1/stream

# --- LLM Provider (Semantic + Workflow Agents) ---
# Prefer OpenRouter (OpenAI-compatible). Falls back to direct OpenAI.

# OpenRouter API key (recommended). Server-side only.
OPENROUTER_API_KEY=

# Optional overrides for OpenRouter
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=https://your-domain.com
# OPENROUTER_X_TITLE=PAL – Meaning-to-Action

# Direct OpenAI key (fallback if OPENROUTER_API_KEY is not set)
OPENAI_API_KEY=

# Model id. For OpenRouter use e.g. openai/gpt-4o-mini or anthropic/claude-3.5-sonnet
# For direct OpenAI use e.g. gpt-4o-mini
OPENAI_MODEL=openai/gpt-4o-mini
