# PAL environment variables
#
# Rule (PAL_ARCHITECTURE.md §73 Rule 2): every variable used by the
# application must be documented here. Never commit real values.
# Copy to .env.local and fill in locally.
#
# SECURITY WARNING (2026-09-15):
# A previous version of this file contained live credentials.
# Those credentials MUST be rotated in Supabase (and any other
# systems that used them) before continuing development.

# --- Supabase (Task 3: auth + workspace tenancy) ---

# Project URL, e.g. https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon / publishable key. Safe for the browser; subject to RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. BYPASSES RLS. Server-side only — never expose to the
# browser, never prefix with NEXT_PUBLIC_ (PAL_ARCHITECTURE.md §43).
SUPABASE_SERVICE_ROLE_KEY=

# Optional: full Postgres connection string for CLI / migrations.
# Prefer the Supabase dashboard connection string or local pooler.
# DATABASE_URL=

# --- Sahara Voice Provider (Task: Voice Ingestion Pipeline) ---

# Sahara API secret. Server-side only; never expose to the browser.
# Used for authenticating streaming speech-to-text connections.
SAHARA_API_SECRET=

# Sahara WebSocket endpoint for streaming audio transcription
SAHARA_WS_ENDPOINT=wss://api.sahara.ai/v1/stream

# --- OpenAI LLM Provider (Task: Semantic Agent) ---

# OpenAI API key for semantic analysis. Server-side only.
# Used by the semantic agent to convert speech into structured meaning.
OPENAI_API_KEY=

# OpenAI model for semantic extraction (default: gpt-4o-mini for cost efficiency)
OPENAI_MODEL=gpt-4o-mini
