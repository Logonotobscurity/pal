# PAL environment template.
# Rule (PAL_ARCHITECTURE.md §73 Rule 2): every variable used by the
# application must be documented here. Never commit real values.
# Copy to .env.local and fill in locally.
#
# SECURITY WARNING (2026-09-15):
# A previous version of this file contained live credentials.
# Those credentials MUST be rotated in Supabase (and any other
# systems that used them) before continuing development.

# --- Supabase (Task 3: auth + workspace tenancy) ---

# Project URL, e.g. https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon / publishable key. Safe for the browser; subject to RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. BYPASSES RLS. Server-side only — never expose to the
# browser, never prefix with NEXT_PUBLIC_ (PAL_ARCHITECTURE.md §43).
SUPABASE_SERVICE_ROLE_KEY=

# Optional: full Postgres connection string for CLI / migrations.
# Prefer the Supabase dashboard connection string or local pooler.
# DATABASE_URL=

# --- Sahara Voice Provider (Task: Voice Ingestion Pipeline) ---

# Sahara API secret. Server-side only; never expose to the browser.
SAHARA_API_SECRET=

# Sahara streaming WebSocket endpoint. Server-side only.
SAHARA_WS_ENDPOINT=

# Sahara model or config ID. Consult Sahara docs for latest.
SAHARA_MODEL_ID=sahara-v2.5

# --- LLM (Semantic + Workflow agents) ---
# Priority: XAI_API_KEY (Grok) > GROQ_API_KEY > OPENROUTER_API_KEY > OPENAI_API_KEY

# Grok / xAI API key (preferred). Server-side only.
# OpenAI-compatible endpoint: https://api.x.ai/v1
XAI_API_KEY=

# Optional override for the xAI base URL (default: https://api.x.ai/v1).
XAI_BASE_URL=

# Model for Grok (default: grok-4.1).
XAI_MODEL=

# Groq inference API key (fast open models). Server-side only.
# OpenAI-compatible endpoint: https://api.groq.com/openai/v1
GROQ_API_KEY=

# Optional override for the Groq base URL (default: https://api.groq.com/openai/v1).
GROQ_BASE_URL=

# Model for Groq (default: llama-3.3-70b-versatile).
GROQ_MODEL=

# OpenAI API key (fallback).
OPENAI_API_KEY=

# Model id used by OpenAI or OpenRouter paths.
OPENAI_MODEL=gpt-4o-mini

# --- OpenRouter (optional) ---

# OpenRouter API key. Server-side only.
OPENROUTER_API_KEY=

# OpenRouter API base URL (default: https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL=

# Optional attribution headers sent to OpenRouter.
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=
